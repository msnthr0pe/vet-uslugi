<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customBottomBar"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:background="?android:attr/background"
    android:gravity="center"
    android:weightSum="4"
    android:elevation="8dp">

    <!-- NEWS — unselected -->
    <LinearLayout
        android:id="@+id/nav_news"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/icon_news"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/news" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Новости"
            android:textSize="11sp"
            android:textColor="@color/icon_gray" />
    </LinearLayout>

    <!-- PLACES — unselected -->
    <LinearLayout
        android:id="@+id/nav_places"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/icon_places"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/places" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Места"
            android:textSize="11sp"
            android:textColor="@color/icon_gray" />
    </LinearLayout>

    <!-- PROFILE — selected -->
    <LinearLayout
        android:id="@+id/nav_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/icon_profile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/profileselected" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Профиль"
            android:textSize="11sp"
            android:textColor="@color/icon_blue"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SURVEY — unselected -->
    <LinearLayout
        android:id="@+id/nav_survey"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/icon_survey"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/survey" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Животные"
            android:textSize="11sp"
            android:textColor="@color/icon_gray" />
    </LinearLayout>

</LinearLayout>
